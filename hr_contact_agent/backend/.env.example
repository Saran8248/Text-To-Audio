# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_contacts

# SQLite Fallback: If PostgreSQL is not reachable, fallback to SQLite for local development
SQLITE_FALLBACK=true
SQLITE_DB_PATH=./hr_contacts.db

# API Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=true
